# nine-quarter 配置示例。复制为 .env 后填写。敏感信息只放 .env（已被 .gitignore 忽略）。

# ---- AI（OpenAI 兼容接口）----
# 也可以在页面 /settings 中配置：保存到本机数据库，优先于本文件，立即生效。
# 火山方舟示例：base_url=https://ark.cn-beijing.volces.com/api/v3
# 若环境中已有 ARK_API_KEY，未填 AI_API_KEY/AI_BASE_URL 时会自动复用方舟地址与密钥。
# AI_MODEL 必填：填你的方舟推理接入点（ep-xxxx）或已开通的模型名。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=8000
AI_TIMEOUT=180
# 如需代理访问 AI 接口，显式填写（不读取系统代理）：
AI_PROXY=

# ---- 账户与风险 ----
INITIAL_CAPITAL=100000
MAX_POSITION_WEIGHT=0.20
ORDER_EXPIRE_DAYS=3

# ---- 初筛 ----
PRESCREEN_COUNT=30
MIN_AVG_AMOUNT_20D=50000000
MIN_PRICE=2.0
MIN_HISTORY_BARS=60
EXCLUDE_ST=1
MIN_DATA_COVERAGE=0.90

# ---- 交易费用 ----
COMMISSION_RATE=0.00025
MIN_COMMISSION=5
STAMP_TAX_RATE=0.0005
TRANSFER_FEE_RATE=0.00001

# ---- 调度（北京时间 Asia/Shanghai）----
MORNING_TIME=09:35
# 盘后多个重试时段：数据未就绪自动等待下一时段，成功则幂等跳过
DAILY_TIMES=18:00,18:30,19:00,19:30

# ---- 数据 ----
BACKFILL_CALENDAR_DAYS=150
# 可选：自定义数据库路径（默认 data/nine-quarter.db）
DB_PATH=